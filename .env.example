DJANGO_SECRET_KEY='replace-with-your-own-secret-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CANVAS_TOKEN='replace-with-your-canvas-access-token'

# Optional: direct live service calls only; the site's demo needs no key.
# The browser always uses fixed offline suggestions, even if a key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
