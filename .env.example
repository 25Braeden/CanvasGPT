DJANGO_SECRET_KEY='replace-with-your-own-secret-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CANVAS_TOKEN='replace-with-your-canvas-access-token'

# demo (default): fixed offline suggestions, no API key or network requests.
# gemini: explicitly opt into live generation using the settings below.
AI_SUGGESTIONS_MODE=demo

# Optional; used only in gemini mode. Get a key from Google AI Studio.
# Free-tier availability, quotas, and data-use terms depend on Google.
GEMINI_API_KEY=''
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=30
