DJANGO_SECRET_KEY='replace-with-your-own-secret-key'
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CANVAS_TOKEN='replace-with-your-canvas-access-token'

# demo (default): fixed offline suggestions, no API key or network requests.
# openai: explicitly opt into live generation using the settings below.
AI_SUGGESTIONS_MODE=demo

# Optional; used only in openai mode (or direct live service calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
